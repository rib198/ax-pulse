  "cards": [
    {
      "title_ar": "خدمة ترتيب الفواتير تبدأ بعشر وثائق",
      "what_happened_ar": "نشرت LlamaIndex مقارنة بين 14 نظامًا لاستخراج المعلومات من الوثائق، وذكرت أن السعر الأعلى لا يعني دقة أعلى في اختبارها.",
      "why_it_matters_ar": "نسخ التواريخ والمبالغ من الفواتير يأكل وقت المكتب، واختيار الأداة باسمها أو سعرها قد يهدر مالاً.",
      "audience_ar": "صاحب متجر يرتب فواتير موردين، موظف إداري، من يفكر في خدمة إدخال بيانات صغيرة.",
      "opportunity_ar": "اعرض تنظيم فواتير متجر صغير في جدول، بعد تجربة الدقة ومراجعة كل مبلغ.",
      "example_ar": "عشر فواتير مورد تخرج في جدول تاريخ ومبلغ واسم، ثم تراجعها قبل أي ترحيل.",
      "first_steps_ar": [
        "اختر نوع وثيقة واحداً وأربعة حقول فقط.",
        "جرّب الأداة على عشر وثائق تجريبية أو منزوعة بيانات العملاء.",
        "عدّ الأخطاء يدوياً ولا تربط النتيجة بالمحاسبة بعد."
      ],
      "caveat_ar": "الأرقام من اختبار الناشر لا من ملفاتك. السعر الحالي ودعم العربية وصيغ مستنداتك تحتاج تحققاً.",
