# AX Pulse / Radar — environment template
#
# Copy this file to `.env` (gitignored) for local dev, OR set these as
# secrets in your deploy target (Vercel / Netlify / GitHub Actions).
#
# This file is committed intentionally so contributors know the surface.
# Never commit a real .env.

# --- Email digest (already in use) ---
RESEND_API_KEY=                # required for tools/build_digest.py
FORMSPREE_FORM_ID=             # used in subscribe.html (free email capture)

# --- AI agents (radar pipeline) ---
OPENAI_API_KEY=                # used by Opportunity Builder, Radar Editor, Growth Social
                               # leave empty to force rule-based fallback

# --- Stripe (subscription, paid plan) ---
# These are READ by a serverless function (not by the static frontend).
# The frontend only reads `data/config.json` for safe public values.
STRIPE_PUBLISHABLE_KEY=        # pk_test_... or pk_live_...
STRIPE_SECRET_KEY=             # sk_test_... or sk_live_... (server only)
STRIPE_WEBHOOK_SECRET=         # whsec_... (server only)
STRIPE_PRICE_ID=               # price_... — the $15/month subscription price

# --- Optional: data sources ---
FEEDLY_TOKEN=                  # for tools/pulse_radar.py (RSS aggregator)
FEEDLY_STREAM_ID=
X_BEARER_TOKEN=                # for X recent search; or use macOS Keychain via setup-x-token.command

# --- Optional: analytics ---
PLAUSIBLE_DOMAIN=              # if you wire Plausible into assets/js/analytics.js
POSTHOG_KEY=                   # if you wire PostHog instead
